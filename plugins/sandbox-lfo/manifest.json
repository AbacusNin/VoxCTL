{
  "id": "sandbox-lfo",
  "name": "Sandbox LFO",
  "version": "0.3.2",
  "type": "controller",
  "apiVersion": "0.3",
  "execution": "isolated",
  "entry": "./plugin.js",
  "description": "Example third-party-style control plugin in a sandboxed iframe. It sees only whether the voice is sounding.",
  "permissions": ["synth.filter.offset"],
  "ui": [
    {"id":"depth","label":"LFO depth","type":"range","min":0,"max":3000,"step":50,"default":1200},
    {"id":"rate","label":"LFO rate","type":"range","min":0.01,"max":0.3,"step":0.01,"default":0.08}
  ]
}
